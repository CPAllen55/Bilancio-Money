# Copy to server/.env and fill in. .env is git-ignored — never commit real values.

# From dashboard.plaid.com -> Developers -> Keys. Sandbox keys are free and instant.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox              # sandbox | production (Plaid retired "development")

# Encrypts bank access tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this means every stored bank connection must be reconnected.
ENCRYPTION_KEY=

# Signs nothing yet, but reserved for session hardening. Any long random string.
SESSION_SECRET=

PORT=3000
DATABASE_FILE=./data/bilancio.db

# Only once deployed to a public HTTPS URL. Plaid cannot reach localhost.
# PLAID_WEBHOOK_URL=https://app.bilanciomoney.com/api/plaid/webhook

# Only needed for OAuth banks (Chase, Wells Fargo). Must be registered in the Plaid dashboard.
# PLAID_REDIRECT_URI=https://app.bilanciomoney.com/
