{
  // Bilancio Money — one Worker, two jobs:
  // static site from public/ at the edge, API on /api/*.
  "name": "bilancio-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* wakes the Worker. Everything else is served
    // straight from the edge, so the site stays as fast as it is today.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
